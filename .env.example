# Server-only Groq credentials. Never expose these as VITE_ variables.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

# Neon Postgres connection string. Keep it server-only.
NEON_DATABASE_URL=

# Optional: set to the real public HTTPS origin before enabling canonical URLs and absolute sitemaps.
PUBLIC_SITE_URL=
